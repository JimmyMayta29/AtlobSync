# ============================================
# Variables de Entorno para API-SIRE
# ============================================
# Copia este archivo como .env y completa con tus credenciales reales
# NUNCA subas el archivo .env a Git

# Credenciales de la API de SUNAT (obtenidas desde el portal de desarrolladores SUNAT)
CLIENT_ID=tu_client_id_aqui
CLIENT_SECRET=tu_client_secret_aqui

# Datos del contribuyente
RUC=12345678901
USUARIO=USUARIO_SOL
CLAVE_SOL=tu_clave_sol_aqui

# Token de acceso (se obtiene automáticamente al llamar /auth/token)
TOKEN=
