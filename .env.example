# ============================================
# Variables de Entorno del Servidor API-SIRE
# ============================================

# Host y Puerto del servidor (seguridad: 127.0.0.1 por defecto)
HOST=127.0.0.1
PORT=8080
GIN_MODE=release

# Llave maestra para cifrado AES-256-GCM de credenciales en base de datos
# Puedes generar una cadena aleatoria de 32 o más caracteres
APP_MASTER_KEY=clave_maestra_secreta_para_cifrado_aes_gcm_2026_sire

# Rutas de almacenamiento local
DB_PATH=data/sire.db
STORAGE_DIR=descargas

# RUC por defecto para soportar rutas heredadas (/api/sunat/...)
DEFAULT_RUC=20000000001
